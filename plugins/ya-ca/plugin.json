{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ya-ca",
  "version": "0.1.2",
  "description": "Неофициальный плагин для Яндекс Календаря с CalDAV и приглашениями через Ya-Mail.",
  "author": {
    "name": "Антон Гребенников"
  },
  "repository": "https://github.com/grebennikovxyz/ya-cal-plugin",
  "license": "Apache-2.0",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Ya-Ca",
        "shortDescription": "Календарь и приглашения",
        "developerName": "Антон Гребенников",
        "category": "Productivity",
        "brandColor": "#086361",
        "logo": "./assets/ya-ca.png",
        "composerIcon": "./assets/ya-ca.png",
        "defaultPrompt": [
          "Покажи мою повестку по всем календарям на завтра",
          "Найди свободный час и пригласи участников через Ya-Mail"
        ]
      }
    }
  }
}
